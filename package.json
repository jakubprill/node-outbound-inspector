{
  "name": "node-outbound-inspector",
  "version": "0.5.0",
  "description": "Inspekcja wychodzącego ruchu HTTP procesów Node.js/Next.js w Chrome DevTools i dla agentów AI (MCP): wiele aplikacji, przypisanie do żądania strony, wykrywanie zapytań sekwencyjnych.",
  "license": "MIT",
  "author": "Jakub Prill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubprill/node-outbound-inspector.git"
  },
  "homepage": "https://github.com/jakubprill/node-outbound-inspector#readme",
  "private": true,
  "type": "module",
  "bin": {
    "outbound-mcp": "src/outbound-mcp.mjs",
    "outbound-next": "bin/outbound-next.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/outbound-mcp.mjs",
    "test": "node --test 'test/**/*.test.mjs'",
    "demo": "node scripts/mcp-demo.mjs",
    "record": "node scripts/record-fixture.mjs --scenario",
    "golden:update": "UPDATE_GOLDEN=1 node --test test/golden/golden.test.mjs"
  },
  "keywords": [
    "mcp",
    "nodejs",
    "nextjs",
    "devtools",
    "network",
    "inspector",
    "cdp",
    "debugging"
  ]
}
